HOST=0.0.0.0
PORT=3000
APP_PUBLIC_URL=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,tauri://localhost
DATABASE_URL=postgresql://strafe:strafe@localhost:5432/strafe
DATABASE_POOL_MAX=10
DATABASE_SSL=disable
# DATABASE_SSL_CA=/path/to/postgresql-ca.pem
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_CHALLENGE_TTL_SECONDS=3600
SESSION_TRUST_GEO_HEADERS=false
REDIS_URL=redis://localhost:6379
GATEWAY_MAX_FRAME_BYTES=65536
GATEWAY_MAX_BUFFERED_BYTES=1048576
GATEWAY_MAX_SUBSCRIPTIONS=250
GATEWAY_COMMANDS_PER_MINUTE=120
GATEWAY_HEARTBEAT_GRACE_MS=15000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=strafe
S3_ACCESS_KEY_ID=strafe
S3_SECRET_ACCESS_KEY=strafe-development-secret
S3_FORCE_PATH_STYLE=true
FILE_MAX_SIZE_BYTES=104857600
FILE_USER_QUOTA_BYTES=2147483648
FILE_PART_SIZE_BYTES=8388608
FILE_PROCESS_INTERVAL_MS=5000
FILE_SCAN_REQUIRED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=strafe-development-search-key
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_FROM=Strafe <no-reply@strafe.local>
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:security@strafe.app
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=replace-with-a-long-livekit-secret
REALTIME_ENABLED=true
OUTBOX_ENABLED=true
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=1000
METRICS_ENABLED=true
SERVICE_VERSION=0.0.0
# SENTRY_DSN=
