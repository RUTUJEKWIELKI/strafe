{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strafe",
  "version": "0.0.0",
  "identifier": "dev.rutujek.strafe",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web exec vite --host 127.0.0.1",
    "beforeBuildCommand": "pnpm --dir ../web exec vite build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: wss:; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob: https:; media-src 'self' blob: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Strafe",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["strafe"]
      }
    }
  }
}
