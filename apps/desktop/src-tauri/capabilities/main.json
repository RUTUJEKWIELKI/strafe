{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for the main Strafe window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "autostart:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "deep-link:default",
    "dialog:default",
    "global-shortcut:default",
    "log:default",
    "notification:default",
    "opener:default",
    "os:default",
    "positioner:default",
    "process:allow-restart",
    "sql:default",
    "store:default",
    "stronghold:default",
    "updater:default",
    "window-state:default"
  ]
}
